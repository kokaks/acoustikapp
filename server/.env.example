# Postgres connection string. On Render+Neon this is provided by Neon; for
# local dev / future Mac mini it points at a local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/warehouse_dev

# Set to "false" for local Postgres without SSL. Leave unset (defaults to
# SSL enabled, cert-relaxed) for Neon.
PGSSL=false

# Secret used to sign employee auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://warehouse.example.com,https://warehouse-staging.onrender.com
CORS_ORIGIN=*

PORT=4000
